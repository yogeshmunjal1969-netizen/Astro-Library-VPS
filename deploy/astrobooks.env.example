# Astro Library server settings - read by systemd (astrobooks.service) and by the `astrobooks` command.
# After changing anything here:  sudo astrobooks restart

# Where the books and the catalogue (_library/library.db) live. Needs ~120 GB for the current collection.
ASTRO_LIB=/srv/astrobooks/library

# User accounts and sign-in sessions (users.db). Back this folder up together with ASTRO_LIB/_library.
ASTRO_DATA=/var/lib/astrobooks

# Cloudflare Tunnel connects to this address. Keep 127.0.0.1 so the site is reachable only through the tunnel.
# To also use it directly on your home network, set ASTRO_BIND=0.0.0.0 and add the server's LAN IP
# (e.g. 192.168.1.50) to ASTRO_ALLOWED_HOSTS, then open http://192.168.1.50:8765
ASTRO_BIND=127.0.0.1
ASTRO_PORT=8765

# Host names the site answers to (anything else is refused).
ASTRO_ALLOWED_HOSTS=astrobooks.munjal.tech,localhost,127.0.0.1

# Uncomment to log every request to the journal (sudo astrobooks logs).
#ASTRO_ACCESS_LOG=1
